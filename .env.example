# ─────────────────────────────────────────────────────────────────────────────
# TSHK Compass subscription edition — environment variables
#
# Copy this file to `.env` for local runs, and add every variable below in
# Vercel → Project → Settings → Environment Variables (Production AND Preview).
#
# These values are SECRETS (except the public ones for public/config.js).
# Never commit a filled-in .env file, and never put the service role key or the
# PayFast passphrase into public/ — everything in public/ reaches the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Public address of the deployed app, no trailing slash.
# Used in: the PayFast return/cancel URLs, and the password-reset link
# (SITE_URL + "/reset"). Locally this is usually http://localhost:3000.
SITE_URL=https://your-app.vercel.app

# ── Supabase (Project Settings → API) ────────────────────────────────────────
# Supplied automatically by Vercel's Supabase integration, or copy manually.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon (public) key. Also goes into public/config.js — it is safe there
# because Row Level Security is what actually protects the data.
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
# The service_role key. SERVER ONLY. Bypasses Row Level Security, so it must
# never appear in public/, in a log, or in an error message.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# ── PayFast (Settings → Integration; sandbox credentials for testing) ────────
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
# Required for subscriptions. Keep it secret — it signs every payment.
PAYFAST_PASSPHRASE=your-payfast-passphrase
# true = sandbox.payfast.co.za (safe default; use it for every test).
# Set to false ONLY for the live merchant account.
PAYFAST_SANDBOX=true
# true = reject ITNs whose source address is not one of PayFast's.
# Leave false until the logs show no "unrecognised address" warnings for real
# ITNs, then turn it on.
PAYFAST_ENFORCE_IP=false

# ── Membership rules (optional; shown defaults are the live values) ──────────
# R100.00 per month. Existing subscribers keep the amount they signed up at.
SUBSCRIPTION_AMOUNT=100
SUBSCRIPTION_ITEM_NAME=TSHK Compass monthly membership
TRIAL_DAYS=7
# Days of access after a late monthly charge, before the paywall returns.
GRACE_DAYS=3

# ─────────────────────────────────────────────────────────────────────────────
# Supabase dashboard settings that go with these variables
# (Authentication → Providers / Email Templates / URL Configuration):
#
# 1. Email provider: ON.  "Confirm email": ON (members must confirm before the
#    app unlocks; the 7-day trial starts at their first sign-in, not at signup).
# 2. Minimum password length: 8 (the API also enforces min 8 with `weak_password`).
# 3. Email templates:
#    - "Confirm signup": mentions the app and links back to the site.
#    - "Reset password": {{ .ConfirmationURL }} — the link must be allowed below.
#    The old TSHK Compass "magic link / 6-digit code" template is no longer used
#    by the app; leave it or clear it, it will not be requested.
# 4. URL Configuration → Redirect URLs: add {SITE_URL}/reset (exactly what the
#    app sends as `redirect_to`), plus http://localhost:3000/reset while testing.
# 5. SMTP: connect a real sender (Resend, SendGrid, Amazon SES, or the church's
#    mail server). Supabase's built-in sender is rate-limited to a handful of
#    messages an hour and is for testing only.
#
# One-time owner escalation (SQL Editor), after the owner has signed up in the
# app once so their members row exists:
#     update public.members set is_admin = true where email = '<owner email>';
# Then reload the app; Admin tools appears in the Account screen.
#
# Seed the 88 centres / 15 regions (idempotent, safe to re-run):
#     run supabase/seed-centres.sql in the SQL Editor after supabase/schema.sql
# ─────────────────────────────────────────────────────────────────────────────
